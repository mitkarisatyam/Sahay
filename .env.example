# SAHAY AI — Environment Variables Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Optional AI Providers (Leave blank to use built-in Zero-Credential Local Grounded RAG Engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Administrative Passkey for Scheme Management and Re-indexing
ADMIN_TOKEN=sahay-admin-secret-2026

# SQLite Database Location (defaults to ./sahay.sqlite)
DB_PATH=./sahay.sqlite

# CORS Allowed Origin
CORS_ORIGIN=*

